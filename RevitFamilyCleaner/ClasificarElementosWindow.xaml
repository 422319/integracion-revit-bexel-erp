<Window x:Class="RevitFamilyCleaner.ClasificarElementosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clasificar elementos por disciplina" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Asigna la disciplina de cada elemento. Luego presiona 'Autonumerar' para generar el subtítulo consecutivo:"
                   Margin="0,0,0,10" FontWeight="Bold" TextWrapping="Wrap"/>

        <DataGrid Grid.Row="1" x:Name="GridElementos" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Familia" Binding="{Binding Familia}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="*" IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="Disciplina" SelectedItemBinding="{Binding Disciplina}" Width="180">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>Arquitectura</sys:String>
                            <sys:String>Estructura</sys:String>
                            <sys:String>Instalaciones Eléctricas</sys:String>
                            <sys:String>Instalaciones Sanitarias</sys:String>
                            <sys:String>Otros</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="Subtítulo" Binding="{Binding Subtitulo}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Detalles" Binding="{Binding Detalles}" Width="*" IsReadOnly="False"/>
                <DataGridTextColumn Header="Ejes" Binding="{Binding Ejes}" Width="100" IsReadOnly="False"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Autonumerar" Width="120" Margin="0,0,10,0" Click="Autonumerar_Click"/>
            <Button Content="Cancelar" Width="100" Margin="0,0,10,0" Click="Cancelar_Click"/>
            <Button Content="Guardar" Width="120" Click="Guardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
